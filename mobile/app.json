{
  "expo": {
    "name": "穿搭灵感库",
    "slug": "fashion-inspo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#6366f1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fashioninspo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366f1"
      },
      "package": "com.fashioninspo.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册以选择穿搭图片",
          "cameraPermission": "允许使用相机拍摄穿搭照片"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许使用相机拍摄穿搭照片"
        }
      ]
    ],
    "scheme": "fashion-inspo"
  }
}
