# 后端运行时配置示例（脱敏）
#
# 用法：复制成 backend/.env 后按本机实际情况改。真正的 .env 已 gitignore，**不要提交**。
#   cp backend/.env.example backend/.env
#
# 本文件登记了 backend/app/config.py 里**所有能通过环境变量覆盖**的设置项；
# 未列出的字段（images_dir / thumbnails_dir 等）是派生路径，由 STORAGE_ROOT 推导，
# 不要单独设置，否则会和 storage 根脱节。
#
# 约定：
# - 布尔值写 true / false（小写）；
# - 列表/元组用 JSON 写法，如 CORS_ORIGINS=["http://localhost:17777"]、THUMBNAIL_SIZE=[400,600]；
# - 密钥类（API_KEY）只在需要对外监听时才填，留空表示只放行回环地址。

# ── 基础 ──────────────────────────────────────────────────────────────
APP_NAME=Fashion Inspo
APP_VERSION=0.1.0
DEBUG=true
HOST=127.0.0.1
PORT=18888

# ── 数据库与存储 ──────────────────────────────────────────────────────
# 活库位置：留空则按 backend/storage/fashion_inspo.db 推导。
# 换到外部盘就写绝对路径（Windows 用 /. 或 // 均可）：
#   DATABASE_URL=sqlite+aiosqlite:///G:/fashion-inspo-storage/fashion_inspo.db
# 注意：DB 与 STORAGE_ROOT 可以不同盘；脚本统一用 settings.db_file_path，不要自行拼路径
#DATABASE_URL=

# 业务文件根（原图/视频/缩略图/关键帧/向量库都挂在它下面）
STORAGE_ROOT=backend/storage

MAX_IMAGE_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=500
# AI 判定「无穿搭内容」的图片是否直接物理删除（视频只留空日志）
AUTO_DELETE_NO_CONTENT_IMAGES=true
THUMBNAIL_SIZE=[400,600]
THUMBNAIL_QUALITY=85

# ── 认证与 CORS ───────────────────────────────────────────────────────
# 留空 = 只允许回环地址访问（单机本地部署的安全边界）；非空则要求 X-API-Key
API_KEY=
# 仅当前端单独托管、浏览器直连 :18888 时才需要放开具体源；不要写 "*"
CORS_ORIGINS=["http://localhost:17777","http://127.0.0.1:17777"]

# ── Ollama / AI 分析 ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct
OLLAMA_EMBEDDING_MODEL=all-minilm
AI_ANALYSIS_TIMEOUT=300
AI_LOW_CONFIDENCE_THRESHOLD=0.6
AI_TEMPERATURE=0.7
AI_TOP_P=0.9
AI_TOP_K=40
AI_NUM_PREDICT=4096
AI_NUM_CTX=16384
# 分析提示词不建议用环境变量覆盖：运行时会被 prompt.txt / prompt_configs.json 接管
# （这两个文件属数据、已 gitignore），在这里改会被静默覆盖

# ── 向量库（LanceDB）─────────────────────────────────────────────────
LANCEDB_TEXT_TABLE=text_vectors
LANCEDB_IMAGE_TABLE=image_vectors
LANCEDB_TEXT_DIM=384
LANCEDB_IMAGE_DIM=512
CLIP_MODEL_NAME=clip-ViT-B-32
VECTOR_TOP_K_DEFAULT=20
VECTOR_SIMILARITY_WEIGHT=0.6
VECTOR_TAG_WEIGHT=0.4

# ── 关键帧 / 视频分析 ────────────────────────────────────────────────
KEYFRAME_INTERVAL_SECONDS=3.0
KEYFRAME_SCENE_THRESHOLD=0.0
KEYFRAME_MAX_FRAMES=60
VIDEO_ANALYSIS_MAX_FRAMES=3
FACE_SCAN_VIDEO_MAX_FRAMES=3

# ── 本地出图（ComfyUI）───────────────────────────────────────────────
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=10.0
IMAGE_GEN_TIMEOUT=600
IMAGE_GEN_POLL_INTERVAL=0.5
IMAGE_GEN_WAIT_VRAM_SECONDS=900
IMAGE_GEN_KEEP_CANDIDATES_DAYS=7

# ── 姿势图库 ─────────────────────────────────────────────────────────
POSE_GALLERY_BASE_URL=https://ai-pose-gallery.anhao.app
POSE_GALLERY_CACHE_HOURS=12

# ── 质量审核 ─────────────────────────────────────────────────────────
# 手动上传是否免审核（true=直接标记已通过）
MANUAL_UPLOAD_AUTO_APPROVE=true
AI_GENERATED_CONFIDENCE_THRESHOLD=0.8
QUALITY_PRECHECK_ENABLED=false
QUALITY_REJECTED_AI_SAMPLE_RATE=0.1
QUALITY_AUTO_TRASH_REJECTED=false
QUALITY_CLASSIFIER_THRESHOLD=0.9
# 标签名最大长度（超出截断，防止模型返回整句当标签）
TAG_NAME_MAX_LENGTH=12

# ── 人脸（独立子服务）────────────────────────────────────────────────
FACE_SERVICE_URL=http://127.0.0.1:18889
FACE_SERVICE_TIMEOUT=30.0
FACE_MATCH_THRESHOLD=0.5

# ── 垃圾桶 ───────────────────────────────────────────────────────────
# 0 = 不自动回收（默认：垃圾桶由用户手动清理）
TRASH_RETENTION_DAYS=0

# ── 并发（SQLite 单写者，默认全部串行；调大前先确认真能被磁盘/GPU 消化）──
WORKER_CONCURRENCY=1
# worker 心跳间隔/心跳超时阈值（秒）。默认 10/90；仅排障或系统测试需要调整
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_STALE_HEARTBEAT_THRESHOLD_SECONDS=90
ANALYZE_CONCURRENCY=1
VECTOR_EMBED_CONCURRENCY=1

# ── 采集（Playwright + Chrome）───────────────────────────────────────
SCRAPER_REQUEST_DELAY=2.0
SCRAPER_MAX_CONCURRENT=3
SCRAPER_DEFAULT_MAX_COUNT=20
SCRAPER_BROWSER_HEADLESS=true
SCRAPER_TASK_AUTO_RETRY=2
# 留空 = 自动探测本机 Chrome 路径 / 使用默认 profile
CHROME_EXECUTABLE=
CHROME_USER_DATA_DIR=
CHROME_DEBUG_PORT=9222
CHROME_AUTO_RESTART_LIMIT=3
CHROME_IDLE_TIMEOUT=600
CHROME_STARTUP_TIMEOUT=20

# ── f2 采集工具联动 ──────────────────────────────────────────────────
# 留空 = 不启用 f2 目录扫描；填 f2 的下载根目录才会做「下载 → 入库」联动
#F2_DOWNLOAD_ROOT=G:/f2-downloads
F2_IMPORT_AUTO_ENABLED=false
F2_IMPORT_INTERVAL_HOURS=24
F2_IMPORT_AUTO_SKIP_LIVE=false
F2_IMPORT_AUTO_MODE=post
F2_FETCH_SINCE_DAYS=14
F2_LIKE_USER=
F2_LIKE_MAX_COUNTS=0

# ── 备份 ─────────────────────────────────────────────────────────────
# 与每日 03:00 的 schtasks 双通道，用 backup.lock 互斥
BACKUP_ON_STARTUP=true
BACKUP_TARGET_PATH=E:/fashion-inspo-backups
BACKUP_STARTUP_DELAY_MINUTES=10
BACKUP_MIN_INTERVAL_HOURS=20
BACKUP_TICK_HOURS=6


# ── 豆包 Seedream 5.0 Flash 云端图生图（默认关闭）──
# 开启后素材图 + 姿态图会上传到火山引擎方舟（cn-beijing），属于隐私边界变更。
# 只在明确接受上传后设置；key 不要提交到仓库。
ARK_ENABLED=false
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
SEEDREAM_TIMEOUT=120
SEEDREAM_MAX_POSES=10
SEEDREAM_DAILY_BUDGET_CNY=5.0
