{
  "manifest_version": 3,
  "name": "AI 穿搭素材采集器",
  "version": "0.1.0",
  "description": "一键采集小红书、抖音等平台的穿搭图片到本地素材库",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "采集穿搭图片"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://localhost:18888/*",
    "http://127.0.0.1:18888/*",
    "https://www.xiaohongshu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://www.douyin.com/*",
    "https://*.douyin.com/*",
    "https://*.douyincdn.com/*",
    "https://*.byteimg.com/*",
    "https://*.douyinpic.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://www.douyin.com/*"
      ],
      "js": ["content-scripts/extract-images.js"],
      "run_at": "document_idle"
    }
  ]
}
